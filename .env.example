# Documentation only — nothing reads this file.
#
# Copy to .env for local overrides (.env is gitignored and never deployed). On
# Cloudflare Pages these are set under Settings → Environment variables, where
# Production and Preview are separate scopes.
#
# All are build-time only, and every one has a default in code: a deploy with
# none of them set works. Precedence: real environment variable → .env →
# default. See docs/deployment.md.

# Absolute origin used for canonicals, hreflang, sitemap and robots.txt.
# Defaults to https://umuhanda.rw when unset.
SITE_URL=

# Microsoft Clarity project id. Defaults to the project baked into
# src/components/Analytics.astro; set to an empty string to disable Clarity.
PUBLIC_CLARITY_PROJECT_ID=

# Search-engine ownership verification (HTML-tag method). Leave unset to omit
# the meta tags — DNS TXT verification needs neither.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
