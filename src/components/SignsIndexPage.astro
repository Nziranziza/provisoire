---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../lib/quiz';
import { imageSrc } from '../lib/quiz';
import { getSignsIndexMetadata } from '../lib/seo';
import {
  SIGN_TYPES,
  getAllSigns,
  signHref,
  signName,
  signsByType,
  signTypeLabel,
  type SignType,
} from '../lib/signs';

interface Props {
  lang: Lang;
  imageBase?: string;
}

const { lang, imageBase = '/' } = Astro.props;
const signs = getAllSigns();
const seo = getSignsIndexMetadata({
  lang,
  site: Astro.site,
  signCount: signs.length,
});

const copy: Record<
  Lang,
  {
    home: string;
    eyebrow: string;
    lead: string;
    quizHub: string;
    count: (n: number) => string;
  }
> = {
  en: {
    home: 'Home',
    eyebrow: 'Sign glossary',
    lead: 'Every distinct Rwanda road sign from the provisional exam bank — meaning, driver action, and linked practice questions.',
    quizHub: 'Practice road-sign questions',
    count: (n) => `${n} signs`,
  },
  fr: {
    home: 'Accueil',
    eyebrow: 'Glossaire des panneaux',
    lead: 'Chaque panneau distinct du permis provisoire rwandais — signification, conduite à tenir et questions liées.',
    quizHub: 'S’entraîner aux questions panneaux',
    count: (n) => `${n} panneaux`,
  },
  rw: {
    home: 'Ahabanza',
    eyebrow: 'Incamake y’ibyapa',
    lead: 'Buri cyapa gihuye n’ikizamini cy’uruhushya rw’agateganyo — ibisobanuro, icyo ugomba gukora n’ibibazo bijyanye.',
    quizHub: 'Wimenyereze ku bibazo by’ibyapa',
    count: (n) => `Ibyapa ${n}`,
  },
};
const t = copy[lang];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={seo.lang}
  canonical={seo.canonical}
  alternates={seo.alternates}
  image={seo.image}
  imageAlt={seo.imageAlt}
  jsonLd={seo.jsonLd}
>
  <main id="main-content" class="min-h-screen bg-stone-100 px-4 py-6 sm:py-8">
    <div class="mx-auto max-w-5xl">
      <nav
        class="mb-4 text-xs font-bold text-slate-500"
        aria-label="Breadcrumb"
      >
        <a href={`/${lang}`} class="hover:text-blue-700 hover:underline"
          >{t.home}</a
        >
        <span class="mx-1.5" aria-hidden="true">/</span>
        <span class="text-slate-800">{t.eyebrow}</span>
      </nav>

      <header class="mb-8">
        <p
          class="text-[11px] font-black tracking-wider text-blue-700 uppercase"
        >
          {t.eyebrow}
        </p>
        <h1
          class="mt-1 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl"
        >
          {
            lang === 'en'
              ? 'Rwanda road signs'
              : lang === 'fr'
                ? 'Panneaux routiers du Rwanda'
                : 'Ibyapa byo ku muhanda mu Rwanda'
          }
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600">
          {t.lead}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <span
            class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-extrabold text-slate-800"
          >
            {t.count(signs.length)}
          </span>
          <a
            href={`/${lang}/road-signs`}
            class="text-xs font-bold text-blue-700 underline-offset-2 hover:underline"
          >
            {t.quizHub} →
          </a>
        </div>
      </header>

      {
        SIGN_TYPES.map((type: SignType) => {
          const group = signsByType(type);
          if (group.length === 0) return null;
          return (
            <section class="mb-10" aria-labelledby={`sign-type-${type}`}>
              <div class="mb-3 flex items-end justify-between gap-3 border-b border-stone-300 pb-2">
                <h2
                  id={`sign-type-${type}`}
                  class="text-lg font-black text-slate-900"
                >
                  {signTypeLabel(type, lang)}
                </h2>
                <span class="text-xs font-bold text-slate-500">
                  {group.length}
                </span>
              </div>
              <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                {group.map((sign) => (
                  <li>
                    <a
                      href={signHref(lang, sign.slug)}
                      class="group flex h-full flex-col rounded-2xl border-2 border-stone-200 bg-white p-3 transition hover:border-slate-900 hover:shadow-sm"
                    >
                      <div class="flex aspect-square items-center justify-center rounded-xl bg-stone-50 p-2">
                        <img
                          src={imageSrc(imageBase, sign.image_url)}
                          alt={signName(sign, lang)}
                          width="120"
                          height="120"
                          class="max-h-full max-w-full object-contain"
                          loading="lazy"
                        />
                      </div>
                      <span class="mt-2 text-xs leading-snug font-extrabold text-slate-900 group-hover:text-blue-700">
                        {signName(sign, lang)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </main>
</BaseLayout>
