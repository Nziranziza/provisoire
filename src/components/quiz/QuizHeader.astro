---
import type { Category, Lang } from '../../lib/quiz';
import {
  categoryHubHref,
  categoryLabel,
  questionsListHref,
} from '../../lib/quiz';

interface Props {
  categories: Category[];
  categoryId?: number;
  lang: Lang;
  page?: number;
  /** Optional counts per category id for clearer labels. */
  categoryCounts?: Record<number, number>;
}

const { categories, categoryId, lang, categoryCounts } = Astro.props;

const allLabel: Record<Lang, string> = {
  en: 'All categories',
  fr: 'Toutes les catégories',
  rw: 'Ibyiciro byose',
};

const eyebrowLabel: Record<Lang, string> = {
  en: 'Rwanda provisional driving-test question bank',
  fr: 'Banque de questions du permis provisoire rwandais',
  rw: 'Ububiko bw’ibibazo by’uruhushya rw’agateganyo mu Rwanda',
};

const headingLabel: Record<Lang, string> = {
  en: 'Questions & Answers',
  fr: 'Questions & Réponses',
  rw: 'Ibibazo n’Ibisubizo',
};

const categoryFilterLabel: Record<Lang, string> = {
  en: 'Category filter',
  fr: 'Filtre de catégorie',
  rw: 'Akayunguruzo k’icyiciro',
};
---

<div
  class="quiz-header mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-3.5 shadow-2xs sm:p-4"
>
  <div>
    <span
      class="mb-1 block text-[11px] font-bold tracking-widest text-blue-700 uppercase"
    >
      {eyebrowLabel[lang]}
    </span>

    <h2
      class="text-xl font-extrabold tracking-wide text-slate-900 uppercase sm:text-2xl"
    >
      {headingLabel[lang]}
    </h2>
  </div>

  <div class="flex items-center gap-2">
    <!-- Category filter -->
    <select
      class="max-w-full rounded-full border-2 border-slate-900 bg-stone-50 px-3 py-1.5 text-xs font-bold text-slate-900"
      aria-label={categoryFilterLabel[lang]}
      onchange="if (this.value) window.location.assign(this.value);"
    >
      <option value={questionsListHref(lang, 1)} selected={!categoryId}>
        {allLabel[lang]}
      </option>
      {
        categories.map((c) => {
          const count = categoryCounts?.[c.id];
          const label =
            typeof count === 'number'
              ? `${categoryLabel(c.id, lang)} (${count})`
              : categoryLabel(c.id, lang);

          return (
            <option
              value={categoryHubHref(lang, c.id)}
              selected={categoryId === c.id}
            >
              {label}
            </option>
          );
        })
      }
    </select>

    <noscript>
      <nav
        class="flex max-w-full flex-wrap gap-2"
        aria-label={categoryFilterLabel[lang]}
      >
        <a
          href={questionsListHref(lang, 1)}
          aria-current={!categoryId ? 'page' : undefined}
          class="rounded-full border-2 border-slate-900 bg-stone-50 px-3 py-1.5 text-xs font-bold text-slate-900"
        >
          {allLabel[lang]}
        </a>
        {
          categories.map((c) => {
            const count = categoryCounts?.[c.id];
            const label =
              typeof count === 'number'
                ? `${categoryLabel(c.id, lang)} (${count})`
                : categoryLabel(c.id, lang);

            return (
              <a
                href={categoryHubHref(lang, c.id)}
                aria-current={categoryId === c.id ? 'page' : undefined}
                class="rounded-full border-2 border-slate-900 bg-stone-50 px-3 py-1.5 text-xs font-bold text-slate-900"
              >
                {label}
              </a>
            );
          })
        }
      </nav>
    </noscript>
  </div>
</div>
