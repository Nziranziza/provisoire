---
import type { Category, Lang } from '../../lib/quiz';
import {
  categoryHubHref,
  categoryLabel,
  categorySlug,
  questionsListHref,
} from '../../lib/quiz';
import HeaderInstallButton from '../HeaderInstallButton.astro';

interface Props {
  categories: Category[];
  categoryId?: number;
  lang: Lang;
  page?: number;
  /** Optional counts per category id for clearer labels. */
  categoryCounts?: Record<number, number>;
}

const { categories, categoryId, lang, page = 1, categoryCounts } = Astro.props;

const locales: { code: Lang; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
  { code: 'rw', label: 'RW' },
];

const allLabel: Record<Lang, string> = {
  en: 'All categories',
  fr: 'Toutes les catégories',
  rw: 'Ibyiciro byose',
};

const eyebrowLabel: Record<Lang, string> = {
  en: 'Rwanda provisional driving-test question bank',
  fr: 'Banque de questions du permis provisoire rwandais',
  rw: 'Ububiko bw’ibibazo by’uruhushya rw’agateganyo mu Rwanda',
};

const headingLabel: Record<Lang, string> = {
  en: 'Questions & Answers',
  fr: 'Questions & Réponses',
  rw: 'Ibibazo n’Ibisubizo',
};
---

<header
  class="mb-4 flex flex-wrap items-end justify-between gap-4 border-b-4 border-slate-900 pb-4"
>
  <div>
    <span
      class="mb-1 block text-[11px] font-bold tracking-widest text-blue-700 uppercase"
    >
      {eyebrowLabel[lang]}
    </span>

    <h2
      class="text-xl font-extrabold tracking-wide text-slate-900 uppercase sm:text-2xl"
    >
      {headingLabel[lang]}
    </h2>
  </div>

  <div class="flex w-full flex-wrap items-center gap-2.5 sm:w-auto">
    <!-- Practice button -->
    <a
      href={`/${lang}/practice`}
      class:list={[
        'inline-flex min-h-[40px] items-center justify-center gap-1 rounded-full border-2 border-slate-900 bg-white px-4 py-2 leading-none font-bold whitespace-nowrap text-slate-800 shadow-2xs transition hover:bg-stone-100 active:scale-95 sm:min-h-[36px]',
        lang === 'fr'
          ? 'text-[11px] tracking-normal sm:text-xs'
          : 'text-[11px] tracking-wide sm:text-xs',
      ]}
    >
      <span aria-hidden="true">💡</span>

      {
        lang === 'fr' ? (
          <>
            <span class="sm:hidden">Pratique</span>
            <span class="hidden sm:inline">Entraînement</span>
          </>
        ) : lang === 'rw' ? (
          'Imyitozo'
        ) : (
          'Practice'
        )
      }
    </a>

    <!-- Install App button -->
    <HeaderInstallButton lang={lang} />

    <!-- Language selector -->
    <div
      class="inline-flex overflow-hidden rounded-full border-2 border-slate-900"
      role="group"
      aria-label="Language"
    >
      {
        locales.map(({ code, label }) => {
          const active = lang === code;

          return (
            <a
              href={questionsListHref(code, page, categoryId)}
              hreflang={code}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'border-r-2 border-slate-900 px-3 py-2 text-xs font-bold tracking-wide transition last:border-r-0',
                active
                  ? 'bg-blue-700 text-white'
                  : 'bg-stone-50 text-slate-900 hover:bg-stone-200',
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </div>

    <!-- Category buttons → hub routes (/en/traffic-rules, /en/road-signs) -->
    <div
      class="inline-flex max-w-full flex-wrap overflow-hidden rounded-full border-2 border-slate-900"
      role="group"
      aria-label="Category"
    >
      <a
        href={questionsListHref(lang, 1)}
        aria-current={!categoryId ? 'page' : undefined}
        class:list={[
          'border-r-2 border-slate-900 px-3 py-2 text-[11px] font-bold tracking-wide no-underline transition last:border-r-0 sm:text-xs',
          !categoryId
            ? 'bg-blue-700 text-white'
            : 'bg-stone-50 text-slate-900 hover:bg-stone-200',
        ]}
      >
        {allLabel[lang]}
      </a>

      {
        categories.map((c) => {
          const count = categoryCounts?.[c.id];
          const name = categoryLabel(c.id, lang);
          const label = typeof count === 'number' ? `${name} (${count})` : name;
          const href = categoryHubHref(lang, c.id);
          const active = categoryId === c.id;

          return (
            <a
              href={href}
              data-category-slug={categorySlug(c.id)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'border-r-2 border-slate-900 px-3 py-2 text-[11px] font-bold tracking-wide no-underline transition last:border-r-0 sm:text-xs',
                active
                  ? 'bg-blue-700 text-white'
                  : 'bg-stone-50 text-slate-900 hover:bg-stone-200',
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>
