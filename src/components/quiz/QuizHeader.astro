---
import type { Category } from '../../lib/quiz';

interface Props {
  categories: Category[];
  categoryId?: number;
}

const { categories, categoryId } = Astro.props;
---

<header
  class="mb-4 flex flex-wrap items-end justify-between gap-4 border-b-4 border-slate-900 pb-4"
>
  <div>
    <span
      class="mb-1 block text-[11px] font-bold tracking-widest text-blue-700 uppercase"
    >
      Rwanda Provisional Test
    </span>
    <h2
      class="text-xl font-extrabold tracking-wide text-slate-900 uppercase sm:text-2xl"
    >
      Question Bank Practice
    </h2>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <div
      class="inline-flex divide-x-2 divide-slate-900 overflow-hidden rounded-full border-2 border-slate-900"
      role="group"
      aria-label="Language"
    >
      <button
        type="button"
        class="lang-btn bg-stone-50 px-3 py-1.5 text-xs font-bold tracking-wide text-slate-900 hover:bg-stone-200"
        data-lang-btn="en"
      >
        EN
      </button>
      <button
        type="button"
        class="lang-btn bg-stone-50 px-3 py-1.5 text-xs font-bold tracking-wide text-slate-900 hover:bg-stone-200"
        data-lang-btn="fr"
      >
        FR
      </button>
      <button
        type="button"
        class="lang-btn bg-stone-50 px-3 py-1.5 text-xs font-bold tracking-wide text-slate-900 hover:bg-stone-200"
        data-lang-btn="rw"
      >
        RW
      </button>
    </div>

    <select
      class="rounded-full border-2 border-slate-900 bg-stone-50 px-3 py-2 text-sm text-slate-900"
      data-category-select
      aria-label="Category"
    >
      <option value="all">All categories</option>
      {
        categories.map((c) => (
          <option value={c.id} selected={categoryId === c.id}>
            {c.name}
          </option>
        ))
      }
    </select>
  </div>
</header>
