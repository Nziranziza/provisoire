---
import type { Category, Lang } from '../../lib/quiz';
import { categorySlug, questionsListHref } from '../../lib/quiz';

interface Props {
  categories: Category[];
  categoryId?: number;
  lang: Lang;
  page?: number;
  /** Optional counts per category id for clearer labels. */
  categoryCounts?: Record<number, number>;
}

const { categories, categoryId, lang, page = 1, categoryCounts } = Astro.props;

const locales: { code: Lang; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
  { code: 'rw', label: 'RW' },
];

const allLabel: Record<Lang, string> = {
  en: 'All categories',
  fr: 'Toutes les catégories',
  rw: 'Ibyiciro byose',
};
---

<header
  class="mb-4 flex flex-wrap items-end justify-between gap-4 border-b-4 border-slate-900 pb-4"
>
  <div>
    <span
      class="mb-1 block text-[11px] font-bold tracking-widest text-blue-700 uppercase"
    >
      Rwanda provisional driving-test question bank
    </span>
    <h2
      class="text-xl font-extrabold tracking-wide text-slate-900 uppercase sm:text-2xl"
    >
      Questions & Answers
    </h2>
  </div>

  <div class="flex w-full flex-wrap items-center gap-2.5 sm:w-auto">
    <div
      class="inline-flex w-full flex-wrap items-center gap-1 rounded-full border-2 border-slate-900 bg-white p-0.5 shadow-2xs sm:w-auto"
    >
      <a
        href={`/${lang}/practice`}
        class:list={[
          'inline-flex min-h-[40px] flex-1 items-center justify-center gap-1 rounded-full px-3 py-1.5 font-bold text-slate-800 whitespace-nowrap leading-none transition hover:bg-stone-100 active:scale-95 sm:min-h-[36px] sm:flex-none',
          lang === 'fr'
            ? 'text-[11px] tracking-normal sm:text-xs'
            : 'text-[11px] tracking-wide sm:text-xs',
        ]}
      >
        <span>💡</span>
        {
          lang === 'fr' ? (
            <>
              <span class="sm:hidden">Pratique</span>
              <span class="hidden sm:inline">Entraînement</span>
            </>
          ) : lang === 'rw' ? (
            'Imyitozo'
          ) : (
            'Practice'
          )
        }
      </a>
      <a
        href={`/${lang}/exam`}
        class:list={[
          'inline-flex min-h-[40px] flex-1 items-center justify-center gap-1 rounded-full bg-amber-400 px-3 py-1.5 font-bold text-slate-900 whitespace-nowrap leading-none transition hover:bg-amber-300 active:scale-95 sm:min-h-[36px] sm:flex-none',
          lang === 'fr'
            ? 'text-[11px] tracking-normal sm:text-xs'
            : 'text-[11px] tracking-wide sm:text-xs',
        ]}
      >
        <span>⏱</span>
        {
          lang === 'fr' ? (
            <>
              <span class="sm:hidden">Examen</span>
              <span class="hidden sm:inline">Examen Blanc</span>
            </>
          ) : lang === 'rw' ? (
            'Ikizamini (20m)'
          ) : (
            'Mock Exam (20m)'
          )
        }
      </a>
    </div>

    <div
      class="inline-flex overflow-hidden rounded-full border-2 border-slate-900"
      role="group"
      aria-label="Language"
    >
      {
        locales.map(({ code, label }) => {
          const active = lang === code;
          return (
            <a
              href={questionsListHref(code, page, categoryId)}
              hreflang={code}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'border-r-2 border-slate-900 px-3 py-2 text-xs font-bold tracking-wide transition last:border-r-0',
                active
                  ? 'bg-blue-700 text-white'
                  : 'bg-stone-50 text-slate-900 hover:bg-stone-200',
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </div>

    <select
      class="rounded-full border-2 border-slate-900 bg-stone-50 px-3 py-2 text-sm text-slate-900"
      data-category-select
      aria-label="Category"
      onchange="const href = this.selectedOptions[0]?.dataset?.href; if (href) window.location.assign(href);"
    >
      <option
        value="all"
        data-href={questionsListHref(lang, 1)}
        selected={!categoryId}
      >
        {allLabel[lang]}
      </option>
      {
        categories.map((c) => {
          const count = categoryCounts?.[c.id];
          const label =
            typeof count === 'number' ? `${c.name} (${count})` : c.name;
          return (
            <option
              value={String(c.id)}
              data-category-slug={categorySlug(c.id)}
              data-href={questionsListHref(lang, 1, c.id)}
              selected={categoryId === c.id}
            >
              {label}
            </option>
          );
        })
      }
    </select>
  </div>
</header>
