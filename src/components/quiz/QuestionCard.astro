---
import type { Lang, Question } from '../../lib/quiz';
import {
  imageSrc,
  questionOptions,
  questionPayload,
  questionText,
} from '../../lib/quiz';
import QuestionResult from './QuestionResult.astro';

interface Props {
  question: Question;
  index: number;
  lang: Lang;
  imageBase: string;
}

const { question: q, index, lang, imageBase } = Astro.props;
const src = imageSrc(imageBase, q.image_url);
const options = questionOptions(q, lang);
---

<li
  class="quiz-item rounded-xl border border-l-4 border-stone-200 border-l-amber-400 bg-white px-4 pt-4 pb-5 transition-colors sm:px-5"
  data-question
  data-question-index={index}
  data-category-id={q.category_id}
  data-payload={questionPayload(q)}
>
  <div class="mb-2 flex items-center justify-between">
    <span
      class="text-xs font-semibold tracking-widest text-slate-400 uppercase"
    >
      {String(index + 1).padStart(2, '0')}
    </span>
    <span
      class="rounded-full bg-slate-900 px-2 py-0.5 text-[10px] font-bold tracking-wide text-white uppercase"
      data-category-badge
    >
      {q.category_name}
    </span>
  </div>

  {
    q.image_url && (
      <div class="quiz-image-wrap mt-2 mb-3">
        <img
          class="block max-h-56 max-w-full rounded-lg border border-stone-200"
          src={src}
          alt=""
          loading="lazy"
          onerror="this.closest('.quiz-image-wrap').classList.add('hidden')"
        />
      </div>
    )
  }

  <p class="mb-3 text-base leading-relaxed font-semibold" data-question-text>
    {questionText(q, lang)}
  </p>

  <ul class="m-0 flex list-none flex-col gap-2 p-0" data-options role="list">
    {
      options.map((opt, idx) => (
        <li>
          <button
            type="button"
            class="quiz-option flex w-full items-center gap-3 rounded-lg border-[1.5px] border-stone-200 bg-stone-50 px-3 py-2.5 text-left text-sm text-slate-900 hover:border-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 disabled:cursor-default"
            data-option-index={idx}
          >
            <span class="quiz-option-marker flex h-6 w-6 flex-none items-center justify-center rounded-full border-[1.5px] border-slate-900 text-xs font-bold">
              {String.fromCharCode(65 + idx)}
            </span>
            <span data-option-text>{opt}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <QuestionResult imageUrl={q.image_url} imageSrc={src} />
</li>
