---
import type { Lang, Question } from '../../lib/quiz';
import {
  categoryLabel,
  correctAnswerText,
  imageSrc,
  questionExplanation,
  questionHref,
  questionNumber,
  questionOptions,
  questionPayload,
  questionText,
} from '../../lib/quiz';
import { questionImageAlt } from '../../lib/seo';
import QuestionAnswerCard from './QuestionAnswerCard.astro';

interface Props {
  question: Question;
  index: number;
  lang: Lang;
  imageBase: string;
  /** When true, the card links to the single-question page. */
  linked?: boolean;
  /** Hide this card (e.g. off the current list page). */
  hidden?: boolean;
}

const {
  question: q,
  index,
  lang,
  imageBase,
  linked = false,
  hidden = false,
} = Astro.props;
const src = imageSrc(imageBase, q.image_url);
const options = questionOptions(q, lang);
const title = questionText(q, lang);
const answer = correctAnswerText(q, lang);
const explanation = questionExplanation(q, lang);
const answerLetter = String.fromCharCode(65 + q.correct_index);
const number = questionNumber(index);
const href = questionHref(lang, number);
const isRoadSigns = q.category_id === 2;
const imageAlt = questionImageAlt(q, lang, number);
const categoryName = categoryLabel(q.category_id, lang);
---

<li
  class:list={[
    'quiz-item rounded-xl border border-l-4 bg-white px-4 pt-4 pb-5 transition sm:px-5',
    isRoadSigns
      ? 'border-stone-200 border-l-sky-600'
      : 'border-stone-200 border-l-amber-500',
    hidden && 'hidden',
  ]}
  data-question
  data-question-index={index}
  data-category-id={q.category_id}
  data-payload={questionPayload(q)}
>
  {
    linked ? (
      <a
        href={href}
        class="mb-2 flex items-center justify-between text-inherit no-underline"
      >
        <span class="text-xs font-semibold tracking-widest text-slate-400 uppercase">
          {String(number).padStart(2, '0')}
        </span>
        <span
          class:list={[
            'rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wide text-white uppercase',
            isRoadSigns ? 'bg-sky-700' : 'bg-amber-700',
          ]}
        >
          {categoryName}
        </span>
      </a>
    ) : (
      <div class="mb-2 flex items-center justify-between">
        <span class="text-xs font-semibold tracking-widest text-slate-400 uppercase">
          {String(number).padStart(2, '0')}
        </span>
        <span
          class:list={[
            'rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wide text-white uppercase',
            isRoadSigns ? 'bg-sky-700' : 'bg-amber-700',
          ]}
        >
          {categoryName}
        </span>
      </div>
    )
  }

  {
    q.image_url && (
      <div class="quiz-image-wrap mt-2 mb-3">
        {linked ? (
          <a href={href} class="block">
            <img
              class="block max-h-56 max-w-full rounded-lg border border-stone-200"
              src={src}
              alt={imageAlt}
              loading="lazy"
              onerror="this.closest('.quiz-image-wrap').classList.add('hidden')"
            />
          </a>
        ) : (
          <img
            class="block max-h-56 max-w-full rounded-lg border border-stone-200"
            src={src}
            alt={imageAlt}
            loading="lazy"
            onerror="this.closest('.quiz-image-wrap').classList.add('hidden')"
          />
        )}
      </div>
    )
  }

  {
    linked ? (
      <a
        href={href}
        class="mb-3 block text-base leading-relaxed font-semibold text-slate-900 no-underline hover:text-blue-700"
        data-question-text
      >
        {title}
      </a>
    ) : (
      <p
        class="mb-3 text-base leading-relaxed font-semibold"
        data-question-text
      >
        {title}
      </p>
    )
  }

  <ul class="m-0 flex list-none flex-col gap-2 p-0" data-options role="list">
    {
      options.map((opt, idx) => {
        const isCorrect = idx === q.correct_index;
        return (
          <li>
            <div
              class:list={[
                'flex w-full items-center gap-3 rounded-lg border-[1.5px] px-3 py-2.5 text-left text-sm',
                isCorrect
                  ? 'border-emerald-600 bg-emerald-50 text-slate-900'
                  : 'border-stone-200 bg-stone-50 text-slate-700',
              ]}
              data-option-index={idx}
              data-correct={isCorrect ? 'true' : 'false'}
            >
              <span
                class:list={[
                  'flex h-6 w-6 flex-none items-center justify-center rounded-full border-[1.5px] text-xs font-bold',
                  isCorrect
                    ? 'border-emerald-600 bg-emerald-600 text-white'
                    : 'border-slate-400 text-slate-600',
                ]}
              >
                {String.fromCharCode(65 + idx)}
              </span>
              <span data-option-text>{opt}</span>
            </div>
          </li>
        );
      })
    }
  </ul>

  <QuestionAnswerCard
    title={title}
    answer={answer}
    answerLetter={answerLetter}
    explanation={explanation}
    imageUrl={q.image_url}
    imageSrc={src}
    imageAlt={imageAlt}
    lang={lang}
  />
</li>
