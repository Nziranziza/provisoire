---
import type { Lang } from '../../lib/quiz';
import { questionsListHref } from '../../lib/quiz';

export interface Props {
  lang: string;
  pageSize: number;
  questionCount: number;
  currentPage?: number;
  categoryId?: number;
  hrefForPage?: (page: number) => string;
}

const {
  lang,
  pageSize,
  questionCount,
  currentPage = 1,
  categoryId,
  hrefForPage,
} = Astro.props;
const totalPages = Math.max(1, Math.ceil(questionCount / pageSize));
const page = Math.min(Math.max(1, currentPage), totalPages);
const locale = lang as Lang;

const getHref = (p: number) => {
  if (hrefForPage) return hrefForPage(p);
  return questionsListHref(locale, p, categoryId);
};

const prevHref = page > 1 ? getHref(page - 1) : null;
const nextHref = page < totalPages ? getHref(page + 1) : null;
---

<nav
  class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t-2 border-slate-900 pt-5"
  aria-label="Question pages"
  data-quiz-pagination
>
  {
    prevHref ? (
      <a
        href={prevHref}
        rel="prev"
        class="rounded-full border border-slate-900 bg-white px-5 py-2.5 text-sm font-bold text-slate-900 transition hover:bg-slate-100"
      >
        Back
      </a>
    ) : (
      <span
        class="rounded-full border border-stone-200 px-5 py-2.5 text-sm font-bold text-stone-300"
        aria-disabled="true"
      >
        Back
      </span>
    )
  }

  <div
    class="rounded-full bg-stone-100 px-3 py-2 text-sm font-semibold text-slate-700"
  >
    Page <span data-page-current-bottom>{page}</span> of
    <span data-page-total-bottom>{totalPages}</span>
  </div>

  {
    nextHref ? (
      <a
        href={nextHref}
        rel="next"
        class="rounded-full border border-slate-900 bg-slate-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700"
      >
        Next
      </a>
    ) : (
      <span
        class="rounded-full border border-stone-200 px-5 py-2.5 text-sm font-bold text-stone-300"
        aria-disabled="true"
      >
        Next
      </span>
    )
  }
</nav>
