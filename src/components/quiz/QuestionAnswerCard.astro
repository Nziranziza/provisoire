---
import type { Lang } from '../../lib/quiz';
import { ANSWER_LABEL } from '../../lib/quiz';

interface Props {
  title: string;
  answer: string;
  answerLetter: string;
  imageUrl: string | null;
  imageSrc: string;
  lang: Lang;
}

const {
  title,
  answer,
  answerLetter,
  imageUrl,
  imageSrc: src,
  lang,
} = Astro.props;
---

<div
  class="mt-4 overflow-hidden rounded-xl border-2 border-emerald-600 bg-emerald-50"
  data-answer-card
>
  <div class="px-4 py-3">
    <p class="text-xs font-bold tracking-widest text-emerald-700 uppercase">
      Answer card
    </p>
    <h3
      class="mt-1 text-base leading-relaxed font-extrabold text-slate-900"
      data-answer-card-title
    >
      {title}
    </h3>
  </div>

  {
    imageUrl && (
      <div
        class="border-t border-emerald-200 bg-white px-4 py-3"
        data-answer-card-image-wrap
      >
        <img
          class="mx-auto block max-h-48 max-w-full rounded-lg border border-stone-200"
          src={src}
          alt=""
          loading="lazy"
          data-answer-card-image
          onerror="this.closest('[data-answer-card-image-wrap]')?.classList.add('hidden')"
        />
      </div>
    )
  }

  <div class="border-t border-emerald-200 px-4 py-3">
    <p class="text-sm leading-relaxed text-slate-900">
      <span class="font-bold text-emerald-700" data-answer-label>
        {ANSWER_LABEL[lang]}
      </span>{' '}
      <span data-answer-text>{answerLetter}. {answer}</span>
    </p>
  </div>
</div>
