---
import type { Lang } from '../lib/quiz';
import { getInstallGuide, type InstallGuideLang } from '../lib/pwa';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const guide = getInstallGuide(lang as InstallGuideLang);

const swCopy = {
  en: { message: 'A new version is ready.', action: 'Update now' },
  fr: {
    message: 'Une nouvelle version est disponible.',
    action: 'Mettre à jour',
  },
  rw: { message: 'Verisiyo nshya irahari.', action: 'Vugurura ubu' },
};

const tSw = swCopy[lang] || swCopy.en;
---

<!-- Global Offline Indicator -->
<aside
  id="pwa-offline-indicator"
  role="status"
  aria-live="polite"
  class="fixed right-4 bottom-4 z-50 hidden max-w-sm items-center gap-2.5 rounded-2xl border px-4 py-2.5 text-xs font-bold shadow-lg backdrop-blur-md transition-all duration-300 sm:right-6 sm:bottom-6"
>
  <span class="flex h-2.5 w-2.5 flex-none items-center justify-center">
    <span id="pwa-offline-dot" class="h-2 w-2 rounded-full"></span>
  </span>
  <p id="pwa-offline-text" class="flex-1 leading-snug"></p>
</aside>

<!-- SW Update Banner -->
<aside
  id="pwa-sw-banner"
  role="status"
  class="fixed top-4 right-4 left-4 z-[90] mx-auto hidden max-w-md items-center justify-between gap-3 rounded-2xl border border-blue-200 bg-blue-50 px-4 py-3 shadow-lg sm:right-6 sm:left-auto"
>
  <p class="text-xs font-semibold text-blue-950 sm:text-sm">{tSw.message}</p>
  <button
    type="button"
    id="pwa-sw-update-btn"
    class="flex min-h-[36px] shrink-0 cursor-pointer touch-manipulation items-center justify-center rounded-full bg-blue-700 px-4 text-xs font-bold text-white transition hover:bg-blue-800 active:scale-95"
  >
    {tSw.action}
  </button>
</aside>

<!-- App Installed Toast -->
<aside
  id="pwa-installed-toast"
  role="status"
  class="fixed top-4 right-4 left-4 z-[95] mx-auto hidden max-w-md items-center gap-3 rounded-2xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-xs font-bold text-emerald-900 shadow-xl sm:right-6 sm:left-auto"
>
  <span class="text-base">🎉</span>
  <p class="flex-1 leading-snug">
    Provisoire is saved & ready for offline practice!
  </p>
</aside>

<!-- Interactive Install Sheet Modal -->
<div
  id="pwa-install-modal"
  class="fixed inset-0 z-[100] hidden items-end justify-center bg-slate-900/60 p-4 backdrop-blur-xs sm:items-center"
  role="dialog"
  aria-modal="true"
>
  <div
    class="w-full max-w-md rounded-2xl border-2 border-slate-900 bg-white p-5 shadow-2xl sm:p-6"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-2xl">🚗</span>
        <h2 class="text-base font-extrabold text-slate-900 sm:text-lg">
          {guide.title}
        </h2>
      </div>
      <button
        type="button"
        id="pwa-install-modal-close"
        class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-100 text-slate-600 hover:bg-stone-200"
        aria-label="Close"
      >
        ✕
      </button>
    </div>
    <p class="mt-2 text-xs leading-relaxed text-slate-600 sm:text-sm">
      {guide.subtitle}
    </p>

    <div class="mt-4 space-y-3">
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-3.5">
        <h3 class="text-xs font-extrabold text-slate-900 uppercase">
          {guide.phoneTitle}
        </h3>
        <ul class="mt-1.5 space-y-1 text-xs text-slate-700 sm:text-sm">
          {guide.phoneSteps.map((step) => <li>{step}</li>)}
        </ul>
      </div>
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-3.5">
        <h3 class="text-xs font-extrabold text-slate-900 uppercase">
          {guide.laptopTitle}
        </h3>
        <ul class="mt-1.5 space-y-1 text-xs text-slate-700 sm:text-sm">
          {guide.laptopSteps.map((step) => <li>{step}</li>)}
        </ul>
      </div>
    </div>

    <!-- Feedback container if browser requires menu action -->
    <div
      id="pwa-modal-feedback"
      class="mt-3 hidden rounded-xl border-2 border-blue-600 bg-blue-50 p-3.5 text-xs text-blue-950"
    >
      <p class="font-extrabold text-blue-900">
        👉 To complete installation on your browser:
      </p>
      <p class="mt-1 leading-relaxed font-medium text-slate-700">
        Click the <strong>Install icon (⊕ / 🖵)</strong> in your address bar at the
        top, or open the browser menu <strong
          >(⋮) → "Save and share" → "Install Provisoire..."</strong
        > (on Android: tap <strong>menu (⋮) → "Install app"</strong>).
      </p>
    </div>

    <div class="mt-5 flex gap-2">
      <button
        type="button"
        id="pwa-modal-try-install"
        class="flex min-h-[44px] flex-1 cursor-pointer touch-manipulation items-center justify-center gap-2 rounded-full bg-blue-700 text-sm font-bold text-white transition hover:bg-blue-800 active:scale-95"
      >
        <span>📲</span>
        <span>Try Direct Install</span>
      </button>
      <button
        type="button"
        id="pwa-install-modal-ok"
        class="flex min-h-[44px] cursor-pointer touch-manipulation items-center justify-center rounded-full border border-slate-300 bg-white px-5 text-sm font-bold text-slate-700 hover:bg-stone-100"
      >
        {guide.close}
      </button>
    </div>
  </div>
</div>

<script>
  import {
    isOnline,
    subscribeNetworkStatus,
    isSwUpdateReady,
    subscribeSwUpdate,
    activateSwUpdate,
    promptInstall,
  } from '../lib/pwa';

  const indicator = document.getElementById('pwa-offline-indicator');
  const dot = document.getElementById('pwa-offline-dot');
  const text = document.getElementById('pwa-offline-text');
  const swBanner = document.getElementById('pwa-sw-banner');
  const swUpdateBtn = document.getElementById('pwa-sw-update-btn');
  const installedToast = document.getElementById('pwa-installed-toast');
  const installModal = document.getElementById('pwa-install-modal');
  const modalCloseBtn = document.getElementById('pwa-install-modal-close');
  const modalOkBtn = document.getElementById('pwa-install-modal-ok');
  const modalTryInstall = document.getElementById('pwa-modal-try-install');
  const modalFeedback = document.getElementById('pwa-modal-feedback');

  function openModal() {
    if (!installModal) return;
    if (modalFeedback) modalFeedback.classList.add('hidden');
    installModal.classList.remove('hidden');
    installModal.classList.add('flex');
  }

  function closeModal() {
    if (!installModal) return;
    if (modalFeedback) modalFeedback.classList.add('hidden');
    installModal.classList.add('hidden');
    installModal.classList.remove('flex');
  }

  modalCloseBtn?.addEventListener('click', closeModal);
  modalOkBtn?.addEventListener('click', closeModal);
  installModal?.addEventListener('click', (e) => {
    if (e.target === installModal) closeModal();
  });

  window.addEventListener('pwa-open-install-guide', openModal);

  modalTryInstall?.addEventListener('click', async () => {
    if (!modalTryInstall) return;
    modalTryInstall.setAttribute('disabled', 'true');
    const originalText = modalTryInstall.innerHTML;
    modalTryInstall.innerHTML =
      '<span>⏳</span><span>Opening installer...</span>';

    try {
      const outcome = await promptInstall();
      if (outcome === 'accepted') {
        closeModal();
      } else if (outcome === 'dismissed') {
        modalTryInstall.removeAttribute('disabled');
        modalTryInstall.innerHTML = originalText;
      } else {
        // Direct browser prompt couldn't trigger automatically
        modalTryInstall.removeAttribute('disabled');
        modalTryInstall.innerHTML = originalText;
        if (modalFeedback) {
          modalFeedback.classList.remove('hidden');
        }
      }
    } catch {
      modalTryInstall.removeAttribute('disabled');
      modalTryInstall.innerHTML = originalText;
    }
  });

  window.addEventListener('pwa-installed', () => {
    if (installedToast) {
      installedToast.classList.remove('hidden');
      installedToast.classList.add('flex');
      setTimeout(() => {
        installedToast.classList.add('hidden');
        installedToast.classList.remove('flex');
      }, 4000);
    }
  });

  const locale = (document.documentElement.lang || 'en') as 'en' | 'fr' | 'rw';
  const offlineLabels = {
    en: {
      offline:
        'Offline Mode · Full question bank & tests are available offline',
      backOnline: 'Back Online · Connection restored',
    },
    fr: {
      offline:
        'Mode Hors-ligne · Banque de questions et tests disponibles sans connexion',
      backOnline: 'En ligne · Connexion rétablie',
    },
    rw: {
      offline:
        'Uburyo budakenera interineti · Ibibazo n’ibizamini birakora neza',
      backOnline: 'Interineti yagarutse · Muri kumwe na interineti',
    },
  };
  const currentLabels = offlineLabels[locale] || offlineLabels.en;

  let reconnectedTimer: ReturnType<typeof setTimeout> | null = null;

  function renderNetwork(online: boolean, wasOffline = false) {
    if (!indicator || !dot || !text) return;
    if (online) {
      if (wasOffline) {
        indicator.className =
          'fixed right-4 bottom-4 z-50 flex max-w-sm items-center gap-2.5 rounded-2xl border px-4 py-2.5 text-xs font-bold shadow-lg backdrop-blur-md transition-all duration-300 sm:right-6 sm:bottom-6 animate-bounce border-emerald-300 bg-emerald-50/95 text-emerald-900 shadow-emerald-900/10';
        dot.className = 'h-2 w-2 rounded-full bg-emerald-600';
        text.textContent = currentLabels.backOnline;
        if (reconnectedTimer) clearTimeout(reconnectedTimer);
        reconnectedTimer = setTimeout(() => {
          indicator.classList.add('hidden');
          indicator.classList.remove('flex');
        }, 3500);
      } else {
        indicator.classList.add('hidden');
        indicator.classList.remove('flex');
      }
    } else {
      if (reconnectedTimer) clearTimeout(reconnectedTimer);
      indicator.className =
        'fixed right-4 bottom-4 z-50 flex max-w-sm items-center gap-2.5 rounded-2xl border px-4 py-2.5 text-xs font-bold shadow-lg backdrop-blur-md transition-all duration-300 sm:right-6 sm:bottom-6 border-amber-300 bg-amber-50/95 text-amber-950 shadow-amber-900/10';
      dot.className = 'h-2 w-2 rounded-full animate-pulse bg-amber-600';
      text.textContent = currentLabels.offline;
    }
  }

  // Initial network check
  if (!isOnline()) {
    renderNetwork(false);
  }

  subscribeNetworkStatus((nowOnline) => {
    renderNetwork(nowOnline, true);
  });

  // SW Update check
  if (isSwUpdateReady() && swBanner) {
    swBanner.classList.remove('hidden');
    swBanner.classList.add('flex');
  }

  subscribeSwUpdate(() => {
    if (swBanner) {
      swBanner.classList.remove('hidden');
      swBanner.classList.add('flex');
    }
  });

  swUpdateBtn?.addEventListener('click', () => {
    activateSwUpdate();
    if (swBanner) {
      swBanner.classList.add('hidden');
      swBanner.classList.remove('flex');
    }
  });
</script>
