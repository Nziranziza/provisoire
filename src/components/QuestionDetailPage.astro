---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuestionCard from './quiz/QuestionCard.astro';
import HeaderInstallButton from './HeaderInstallButton.astro';
import type { Category, Lang, Question } from '../lib/quiz';
import {
  LOCALES,
  categoryHubHref,
  categoryLabel,
  questionHref,
  questionNumber,
  questionsListHref,
} from '../lib/quiz';
import { getQuestionPageMetadata } from '../lib/seo';
import questionBank from '../../questions.json';

interface Props {
  lang: Lang;
  question: Question;
  index: number;
  total: number;
  imageBase?: string;
}

const { lang, question, index, total, imageBase = '/' } = Astro.props;
const number = questionNumber(index);

const copy: Record<
  Lang,
  {
    back: string;
    prev: string;
    next: string;
  }
> = {
  en: {
    back: 'Back to all questions',
    prev: 'Previous',
    next: 'Next',
  },
  fr: {
    back: 'Retour à toutes les questions',
    prev: 'Précédente',
    next: 'Suivante',
  },
  rw: {
    back: 'Subira ku bibazo byose',
    prev: 'Ibanza',
    next: 'Ikurikira',
  },
};

const labels = copy[lang];
const allCategoriesLabel: Record<Lang, string> = {
  en: 'All categories',
  fr: 'Toutes les catégories',
  rw: 'Ibyiciro byose',
};
const hasPrev = number > 1;
const hasNext = number < total;
const categories = questionBank.categories as Category[];

const seo = getQuestionPageMetadata({
  lang,
  question,
  number,
  total,
  site: Astro.site,
  imageBase,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={seo.lang}
  canonical={seo.canonical}
  prev={seo.prev}
  next={seo.next}
  alternates={seo.alternates}
  image={seo.image}
  imageAlt={seo.imageAlt}
  type="article"
  jsonLd={seo.jsonLd}
>
  <main class="m-0 bg-stone-100 px-4 py-10">
    <div class="mx-auto max-w-3xl">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <a
          href={questionsListHref(lang)}
          class="text-sm font-bold text-blue-700 underline-offset-2 hover:underline"
        >
          ← {labels.back}
        </a>
        <div class="flex items-center gap-2.5">
          <HeaderInstallButton lang={lang} />
          <div
            class="inline-flex overflow-hidden rounded-full border-2 border-slate-900"
            role="group"
            aria-label="Language"
          >
            {
              LOCALES.map((code) => {
                const active = lang === code;
                return (
                  <a
                    href={questionHref(code, number)}
                    hreflang={code}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'border-r-2 border-slate-900 px-3 py-2 text-xs font-bold tracking-wide transition last:border-r-0',
                      active
                        ? 'bg-blue-700 text-white'
                        : 'bg-stone-50 text-slate-900 hover:bg-stone-200',
                    ]}
                  >
                    {code.toUpperCase()}
                  </a>
                );
              })
            }
          </div>
          <select
            class="max-w-full rounded-full border-2 border-slate-900 bg-stone-50 px-3 py-2 text-xs font-bold text-slate-900"
            aria-label="Category filter"
            onchange="if (this.value) window.location.assign(this.value);"
          >
            <option
              value={questionsListHref(lang, 1)}
              selected={!question.category_id}
            >
              {allCategoriesLabel[lang]}
            </option>
            {
              categories.map((category) => (
                <option
                  value={categoryHubHref(lang, category.id)}
                  selected={question.category_id === category.id}
                >
                  {categoryLabel(category.id, lang)}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <article
        class="rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:p-7"
      >
        <ul class="m-0 list-none p-0">
          <QuestionCard
            question={question}
            index={index}
            lang={lang}
            imageBase={imageBase}
          />
        </ul>
      </article>

      <nav
        class="mt-6 flex flex-wrap items-center justify-between gap-3"
        aria-label="Question navigation"
      >
        {
          hasPrev ? (
            <a
              href={questionHref(lang, number - 1)}
              rel="prev"
              class="rounded-full border border-slate-900 bg-white px-5 py-2.5 text-sm font-bold text-slate-900 transition hover:bg-slate-100"
            >
              ← {labels.prev}
            </a>
          ) : (
            <span class="rounded-full border border-stone-200 px-5 py-2.5 text-sm font-bold text-stone-300">
              ← {labels.prev}
            </span>
          )
        }

        <span class="text-sm font-semibold text-slate-600">
          {number} / {total}
        </span>

        {
          hasNext ? (
            <a
              href={questionHref(lang, number + 1)}
              rel="next"
              class="rounded-full border border-slate-900 bg-slate-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700"
            >
              {labels.next} →
            </a>
          ) : (
            <span class="rounded-full border border-stone-200 px-5 py-2.5 text-sm font-bold text-stone-300">
              {labels.next} →
            </span>
          )
        }
      </nav>
    </div>
  </main>
</BaseLayout>
