---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuestionList from '../components/questionList.astro';
import type { Lang, Question } from '../lib/quiz';
import {
  PAGE_SIZE,
  globalQuestionIndex,
  parsePageParam,
  questionsListHref,
  totalQuestionPages,
} from '../lib/quiz';
import questionBank from '../../questions.json';
import {
  breadcrumbJsonLd,
  categoryFaqJsonLd,
  getListPageMetadata,
  listJsonLd,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';

interface Props {
  lang: Lang;
  page?: number;
  categoryId?: number;
  isHome?: boolean;
}

const { lang, page: pageProp, categoryId, isHome = false } = Astro.props;

const category = categoryId
  ? questionBank.categories.find((c) => c.id === categoryId)
  : undefined;

const bankQuestions = questionBank.questions as Question[];
const filteredQuestions = categoryId
  ? bankQuestions.filter((q) => q.category_id === categoryId)
  : bankQuestions;
const totalPages = totalQuestionPages(filteredQuestions.length, PAGE_SIZE);
const page = parsePageParam(String(pageProp ?? 1), totalPages);
const start = (page - 1) * PAGE_SIZE;
const pageQuestions = filteredQuestions.slice(start, start + PAGE_SIZE);

const seo = getListPageMetadata({
  lang,
  page,
  totalPages,
  categoryId,
  site: Astro.site,
  isHome,
});

const questionNumbers = pageQuestions.map(
  (q) => globalQuestionIndex(bankQuestions, q) + 1,
);

const jsonLd: Record<string, unknown>[] = [];

if (isHome) {
  jsonLd.push(webSiteJsonLd({ site: Astro.site }));
  jsonLd.push(organizationJsonLd({ site: Astro.site }));
}

if (category) {
  jsonLd.push(
    categoryFaqJsonLd({
      lang,
      questions: pageQuestions,
      categoryName: category.name,
      site: Astro.site,
    }),
  );
}

jsonLd.push(
  listJsonLd({
    lang,
    page,
    totalPages,
    questions: pageQuestions,
    startIndex: start,
    site: Astro.site,
    categoryId,
    questionNumbers,
  }),
);

const listLabels: Record<Lang, { all: string; home: string }> = {
  en: { all: 'Questions', home: 'Provisoire' },
  fr: { all: 'Questions', home: 'Provisoire' },
  rw: { all: 'Ibibazo', home: 'Provisoire' },
};
const listLabel = category
  ? categoryId === 1
    ? lang === 'fr'
      ? 'Code de la route'
      : lang === 'rw'
        ? "Amategeko y'umuhanda"
        : 'Traffic Rules'
    : lang === 'fr'
      ? 'Panneaux de signalisation'
      : lang === 'rw'
        ? 'Ibyapa byo mu muhanda'
        : 'Road Signs'
  : listLabels[lang].all;

const breadcrumbItems = isHome
  ? [{ name: 'Provisoire', path: '/' }]
  : [
      { name: listLabels[lang].home, path: '/' },
      { name: listLabels[lang].all, path: questionsListHref(lang, 1) },
      ...(category
        ? [
            {
              name: listLabel,
              path: questionsListHref(lang, 1, categoryId),
            },
          ]
        : []),
      ...(page > 1
        ? [
            {
              name: lang === 'rw' ? `Paji ya ${page}` : `Page ${page}`,
              path: questionsListHref(lang, page, categoryId),
            },
          ]
        : []),
    ];

jsonLd.push(breadcrumbJsonLd(breadcrumbItems, Astro.site));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={seo.lang}
  canonical={seo.canonical}
  prev={seo.prev}
  next={seo.next}
  alternates={seo.alternates}
  jsonLd={jsonLd}
>
  <main class="m-0 bg-stone-100 px-4 py-10">
    <QuestionList
      lang={lang}
      imageBase="/"
      page={page}
      categoryId={categoryId}
    />
  </main>
</BaseLayout>
