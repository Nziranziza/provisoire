---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeSession from './PracticeSession';
import type { Lang } from '../lib/quiz';
import type { ExamMode } from './practice/types';
import { breadcrumbJsonLd, getPracticePageMetadata } from '../lib/seo';

interface Props {
  lang: Lang;
  initialCategory?: number | null;
  initialMode?: ExamMode;
}

const {
  lang,
  initialCategory: propCategory = null,
  initialMode = 'practice',
} = Astro.props;

const urlCatParam =
  Astro.url.searchParams.get('category') || Astro.url.searchParams.get('cat');
let initialCategory = propCategory;
if (initialCategory === null && urlCatParam) {
  if (urlCatParam === 'traffic-rules' || urlCatParam === '1')
    initialCategory = 1;
  else if (urlCatParam === 'road-signs' || urlCatParam === '2')
    initialCategory = 2;
}

const isExam = initialMode === 'mock_exam';
const seo = getPracticePageMetadata({
  lang,
  mode: isExam ? 'mock_exam' : 'practice',
  site: Astro.site,
});

const homeLabels: Record<Lang, string> = {
  en: 'Provisoire',
  fr: 'Provisoire',
  rw: 'Provisoire',
};
const pageLabels: Record<Lang, { practice: string; exam: string }> = {
  en: { practice: 'Practice Mode', exam: 'Mock Exam' },
  fr: { practice: 'Mode Entraînement', exam: 'Examen Blanc' },
  rw: { practice: 'Uburyo bw’imyitozo', exam: 'Ikizamini cy’ikitegererezo' },
};

const pageLabel = isExam ? pageLabels[lang].exam : pageLabels[lang].practice;

const jsonLd = [
  breadcrumbJsonLd(
    [
      { name: homeLabels[lang], path: `/${lang}` },
      { name: pageLabel, path: seo.canonical },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={seo.lang}
  canonical={seo.canonical}
  alternates={seo.alternates}
  robots="noindex,nofollow"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-stone-100 px-4 py-6 sm:py-10">
    <div class="mx-auto max-w-3xl">
      <PracticeSession
        client:only="react"
        lang={lang}
        imageBase="/"
        initialCategory={initialCategory}
        initialMode={initialMode}
      />
    </div>
  </main>
</BaseLayout>
