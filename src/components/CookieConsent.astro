---
import type { Lang } from '../lib/quiz';
import { getPrivacyContent } from '../lib/privacy-content';

interface Props {
  lang?: Lang;
}

const { lang = 'rw' } = Astro.props;
const content = getPrivacyContent(lang);
const t = content.banner;
---

<aside
  id="cookie-consent-banner"
  role="region"
  aria-label="Cookie consent"
  class="fixed right-4 bottom-4 left-4 z-[95] mx-auto hidden max-w-lg items-center gap-3.5 rounded-2xl border-2 border-slate-900 bg-white p-4 text-xs font-bold text-slate-900 shadow-2xl transition-all duration-300 sm:right-6 sm:left-auto sm:p-5"
>
  <div class="flex items-start gap-3">
    <span class="text-2xl" aria-hidden="true">🍪</span>
    <div class="flex-1">
      <p
        class="text-xs leading-relaxed font-semibold text-slate-700 sm:text-sm"
      >
        {t.message}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="cookie-consent-accept-btn"
          class="inline-flex min-h-[36px] cursor-pointer touch-manipulation items-center justify-center rounded-full bg-blue-700 px-4 py-1.5 text-xs font-extrabold text-white shadow-xs transition hover:bg-blue-800 active:scale-95"
        >
          {t.accept}
        </button>

        <button
          type="button"
          id="cookie-consent-decline-btn"
          class="inline-flex min-h-[36px] cursor-pointer touch-manipulation items-center justify-center rounded-full border-2 border-slate-900 bg-white px-3.5 py-1.5 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
        >
          {t.decline}
        </button>

        <a
          href={`/${lang}/privacy`}
          class="ml-auto text-xs font-bold text-blue-700 underline-offset-2 hover:underline"
        >
          {t.learnMore}
        </a>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  (function initCookieConsent() {
    const banner = document.getElementById('cookie-consent-banner');
    const acceptBtn = document.getElementById('cookie-consent-accept-btn');
    const declineBtn = document.getElementById('cookie-consent-decline-btn');
    const STORAGE_KEY = 'provisoire_cookie_consent';

    function checkConsent() {
      try {
        const consent = localStorage.getItem(STORAGE_KEY);
        if (!consent && banner) {
          banner.classList.remove('hidden');
          banner.classList.add('flex');
        }
      } catch {
        // LocalStorage disabled
      }
    }

    function setConsent(status) {
      try {
        localStorage.setItem(STORAGE_KEY, status);
      } catch {
        // Fallback
      }
      if (banner) {
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      }
      window.dispatchEvent(
        new CustomEvent('cookie-consent-updated', {
          detail: { consent: status },
        }),
      );
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => setConsent('granted'));
    }

    if (declineBtn) {
      declineBtn.addEventListener('click', () => setConsent('denied'));
    }

    window.addEventListener('cookie-consent-reset', () => {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        // Fallback
      }
      if (banner) {
        banner.classList.remove('hidden');
        banner.classList.add('flex');
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkConsent);
    } else {
      checkConsent();
    }
  })();
</script>
