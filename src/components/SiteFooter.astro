---
import type { Lang } from '../lib/quiz';
import { categoryHubHref, questionsListHref } from '../lib/quiz';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const labels: Record<
  Lang,
  {
    tagline: string;
    practice: string;
    exam: string;
    questions: string;
    trafficRules: string;
    roadSigns: string;
    about: string;
    share: string;
    shareToast: string;
    shareTitle: string;
    shareText: string;
    languageSelector: string;
    backToTop: string;
    disclaimer: string;
    nav: string;
  }
> = {
  en: {
    tagline: 'Study support for Rwanda driving theory',
    practice: 'Practice',
    exam: 'Mock Exam',
    questions: 'Questions',
    trafficRules: 'Traffic rules',
    roadSigns: 'Road signs',
    about: 'About',
    share: 'Share',
    shareToast: 'Link copied to clipboard!',
    shareTitle: 'Provisoire - Rwanda Driving Theory Test Prep',
    shareText:
      'Practice official Rwanda driving questions and mock exams offline for free!',
    languageSelector: 'Language selector',
    backToTop: 'Top',
    disclaimer:
      'Independent study support for the Rwanda National Police (RNP) provisional driving test.',
    nav: 'Footer navigation',
  },
  fr: {
    tagline: 'Aide à l’étude pour le code de la route au Rwanda',
    practice: 'Entraînement',
    exam: 'Examen blanc',
    questions: 'Questions',
    trafficRules: 'Règles de circulation',
    roadSigns: 'Panneaux routiers',
    about: 'À propos',
    share: 'Partager',
    shareToast: 'Lien copié dans le presse-papiers !',
    shareTitle: 'Provisoire — Entraînement au code de la route rwandais',
    shareText:
      'Entraînez-vous gratuitement aux questions officielles du code rwandais et aux examens blancs hors ligne !',
    languageSelector: 'Sélecteur de langue',
    backToTop: 'Haut',
    disclaimer:
      'Support d’étude indépendant pour l’examen du permis provisoire au Rwanda.',
    nav: 'Navigation du pied de page',
  },
  rw: {
    tagline: 'Ubufasha bwo kwiga amategeko y’umuhanda mu Rwanda',
    practice: 'Imyitozo',
    exam: 'Ikizamini',
    questions: 'Ibibazo',
    trafficRules: 'Amategeko y’umuhanda',
    roadSigns: 'Ibyapa byo ku muhanda',
    about: 'Ibyerekeye',
    share: 'Sangiza',
    shareToast: 'Ihuza ryamaze gukopororwa !',
    shareTitle:
      'Provisoire — Kwitegura ikizamini cy’amategeko y’umuhanda mu Rwanda',
    shareText:
      'Itoze ibibazo by’amategeko y’umuhanda n’ibizamini by’ikitegererezo ku buntu ndetse no kuri interineti itariho!',
    languageSelector: 'Guhitamo ururimi',
    backToTop: 'Hejuru',
    disclaimer:
      'Umfashanyigisho yigenga ifasha kwitegura ikizamini cy’uruhushya rw’agateganyo.',
    nav: 'Kugenda kuri footer',
  },
};

const t = labels[lang] ?? labels.en;

const pathname = Astro.url.pathname;

const locales: { code: Lang; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
  { code: 'rw', label: 'RW' },
];

function getLocalizedPath(targetLang: Lang, currentPath: string): string {
  const parts = currentPath.split('/').filter(Boolean);
  if (parts.length === 0) return `/${targetLang}`;
  if (parts[0] === 'en' || parts[0] === 'fr' || parts[0] === 'rw') {
    parts[0] = targetLang;
    return '/' + parts.join('/');
  }
  return `/${targetLang}/${parts.join('/')}`;
}

const isAboutPage =
  Astro.url.pathname.endsWith('/about') ||
  Astro.url.pathname.endsWith('/about/') ||
  Astro.url.pathname.includes('/about');

const navLinks = [
  {
    href: `/${lang}/practice`,
    label: t.practice,
    icon: '💡',
    variant: 'default',
  },
  {
    href: `/${lang}/exam`,
    label: t.exam,
    icon: '⏱️',
    variant: 'default',
  },
  {
    href: questionsListHref(lang, 1),
    label: t.questions,
    icon: null,
    variant: 'default',
  },
  {
    href: categoryHubHref(lang, 'traffic-rules'),
    label: t.trafficRules,
    icon: null,
    variant: 'default',
  },
  {
    href: categoryHubHref(lang, 'road-signs'),
    label: t.roadSigns,
    icon: null,
    variant: 'default',
  },
  ...(!isAboutPage
    ? [
        {
          href: `/${lang}/about`,
          label: t.about,
          icon: null,
          variant: 'amber',
        },
      ]
    : []),
];
---

<footer class="border-t border-slate-800 bg-[#14181F] text-[#F2F4F7]">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
    <!-- Top Row: Brand & Utility Actions -->
    <div
      class="flex flex-col items-start justify-between gap-4 border-b border-white/10 pb-5 sm:flex-row sm:items-center"
    >
      <!-- Brand & Tagline -->
      <a
        href={`/${lang}`}
        class="flex items-center gap-3 transition hover:opacity-90"
      >
        <div class="relative shrink-0">
          <img
            src="/icons/icon.svg"
            alt="Provisoire logo"
            width="40"
            height="40"
            class="h-10 w-10 rounded-xl object-contain shadow-xs"
            loading="lazy"
          />
          <span
            class="absolute -top-1 -right-1 h-2.5 w-2.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.9)]"
            aria-hidden="true"></span>
        </div>
        <div>
          <div
            class="text-base font-black tracking-tight text-[#F2F4F7] sm:text-lg"
          >
            Provisoire
          </div>
          <p
            class="mt-0.5 text-[11px] leading-snug text-[#F2F4F7]/70 sm:text-xs"
          >
            {t.tagline}
          </p>
        </div>
      </a>

      <!-- Right Utility Actions: Share, Language Switcher, Back to Top -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Share button -->
        <button
          type="button"
          id="footer-share-btn"
          class="inline-flex min-h-[36px] cursor-pointer touch-manipulation items-center justify-center gap-1.5 rounded-full border-2 border-slate-900 bg-white px-3.5 py-1.5 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
          title={t.share}
        >
          <span aria-hidden="true">🔗</span>
          <span>{t.share}</span>
        </button>

        <!-- Language selector -->
        <div
          class="inline-flex min-h-[36px] overflow-hidden rounded-full border-2 border-slate-900 shadow-2xs"
          role="group"
          aria-label={t.languageSelector}
        >
          {
            locales.map(({ code, label }) => {
              const active = lang === code;
              const targetHref = getLocalizedPath(code, pathname);

              return (
                <a
                  href={targetHref}
                  hreflang={code}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center justify-center border-r-2 border-slate-900 px-3 py-1.5 text-xs font-bold tracking-wide transition last:border-r-0',
                    active
                      ? 'bg-blue-700 font-extrabold text-white'
                      : 'bg-stone-50 font-bold text-slate-900 hover:bg-stone-200',
                  ]}
                >
                  {label}
                </a>
              );
            })
          }
        </div>

        <!-- Back to Top button -->
        <button
          type="button"
          id="footer-back-to-top"
          class="inline-flex min-h-[36px] cursor-pointer touch-manipulation items-center justify-center gap-1.5 rounded-full border-2 border-slate-900 bg-white px-3.5 py-1.5 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
          aria-label={t.backToTop}
          title={t.backToTop}
        >
          <span aria-hidden="true">↑</span>
          <span>{t.backToTop}</span>
        </button>
      </div>
    </div>

    <!-- Navigation Links aligned left to right -->
    <nav class="py-4" aria-label={t.nav}>
      <ul class="flex flex-wrap items-center justify-start gap-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'inline-flex min-h-[36px] items-center justify-center gap-1.5 rounded-full border-2 border-slate-900 px-4 py-1.5 text-xs font-extrabold shadow-2xs transition active:scale-95',
                  link.variant === 'amber'
                    ? 'bg-amber-300 text-slate-950 hover:bg-amber-400'
                    : 'bg-white text-slate-900 hover:bg-stone-100',
                ]}
              >
                {link.icon && <span aria-hidden="true">{link.icon}</span>}
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Bottom Disclaimer & Copyright Row -->
    <div
      class="flex flex-col items-start justify-between gap-2 border-t border-white/10 pt-4 text-[11px] text-[#F2F4F7]/60 sm:flex-row sm:items-center sm:text-left"
    >
      <p class="max-w-xl leading-relaxed">
        {t.disclaimer}
      </p>
      <p class="shrink-0 font-semibold text-[#F2F4F7]/80">© 2026 Provisoire.</p>
    </div>
  </div>

  <!-- Interactive Toast Notification -->
  <div
    id="footer-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-6 left-1/2 z-50 hidden -translate-x-1/2 items-center gap-2 rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-lg transition-all duration-300"
  >
    <span>✅</span>
    <span id="footer-toast-message">{t.shareToast}</span>
  </div>
</footer>

<script
  is:inline
  define:vars={{
    shareToastMsg: t.shareToast,
    shareTitleMsg: t.shareTitle,
    shareTextMsg: t.shareText,
  }}
>
  (function initFooter() {
    // Smooth Back to Top
    const backToTopBtn = document.getElementById('footer-back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Interactive Share & Toast Notification
    const shareBtn = document.getElementById('footer-share-btn');
    const toast = document.getElementById('footer-toast');
    const toastMsg = document.getElementById('footer-toast-message');
    let toastTimeout;

    function showToast(msg) {
      if (!toast) return;
      if (toastMsg && msg) toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('inline-flex');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('inline-flex');
      }, 3000);
    }

    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: shareTitleMsg,
          text: shareTextMsg,
          url: window.location.href,
        };

        if (
          navigator.share &&
          navigator.canShare &&
          navigator.canShare(shareData)
        ) {
          try {
            await navigator.share(shareData);
          } catch {
            // Cancelled
          }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            showToast(shareToastMsg || 'Link copied to clipboard!');
          } catch {
            showToast('Provisoire: ' + window.location.href);
          }
        }
      });
    }
  })();
</script>
