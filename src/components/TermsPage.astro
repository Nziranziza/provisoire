---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderInstallButton from './HeaderInstallButton.astro';
import type { Lang } from '../lib/quiz';
import { categoryHubHref, questionsListHref } from '../lib/quiz';
import {
  absoluteUrl,
  breadcrumbJsonLd,
  hreflangAlternates,
  organizationJsonLd,
} from '../lib/seo';
import { getTermsContent } from '../lib/terms-content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getTermsContent(lang);
const canonicalPath = `/${lang}/terms`;
const alternates = hreflangAlternates(
  (locale) => `/${locale}/terms`,
  Astro.site,
);
const jsonLd = [
  organizationJsonLd({ site: Astro.site, name: 'Provisoire' }),
  breadcrumbJsonLd(
    [
      { name: content.home, path: `/${lang}` },
      { name: content.terms, path: canonicalPath },
    ],
    Astro.site,
  ),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: content.title,
    description: content.description,
    inLanguage: lang,
    url: absoluteUrl(canonicalPath, Astro.site),
    isPartOf: {
      '@type': 'WebSite',
      name: 'Provisoire',
      url: absoluteUrl('/', Astro.site),
    },
  },
];

const locales: { code: Lang; label: string }[] = [
  { code: 'rw', label: 'RW' },
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
];

const practiceLabel: Record<Lang, string> = {
  en: 'Practice',
  fr: 'Entraînement',
  rw: 'Imyitozo',
};

const statsLabels: Record<
  Lang,
  {
    statusTitle: string;
    statusDesc: string;
    govTitle: string;
    govDesc: string;
    accessTitle: string;
    accessDesc: string;
    usageTitle: string;
    usageDesc: string;
  }
> = {
  en: {
    statusTitle: 'Project Status',
    statusDesc: 'Unofficial Study Aid',
    govTitle: 'Government Affiliation',
    govDesc: 'None / Independent',
    accessTitle: 'Cost',
    accessDesc: '100% Free & Open',
    usageTitle: 'Permitted Use',
    usageDesc: 'Personal Learning',
  },
  fr: {
    statusTitle: 'Statut du projet',
    statusDesc: 'Outil non officiel',
    govTitle: 'Affiliation gouvernementale',
    govDesc: 'Aucune / Indépendant',
    accessTitle: 'Tarif',
    accessDesc: '100% Gratuit & Libre',
    usageTitle: 'Usage autorisé',
    usageDesc: 'Étude personnelle',
  },
  rw: {
    statusTitle: 'Uko umushinga uhagaze',
    statusDesc: 'Ubufasha bwo kwiga gusa',
    govTitle: 'Guhuza na Leta',
    govDesc: 'Nta sano / Wigenga',
    accessTitle: 'Igiciro',
    accessDesc: 'Ubuntu 100%',
    usageTitle: 'Imikoreshereze',
    usageDesc: 'Kwiga ku giti cyawe',
  },
};

const languageMap: Record<string, { code: Lang; name: string; flag: string }> =
  {
    Kinyarwanda: { code: 'rw', name: 'Kinyarwanda', flag: '🇷🇼' },
    English: { code: 'en', name: 'English', flag: '🇬🇧' },
    Français: { code: 'fr', name: 'Français', flag: '🇫🇷' },
  };
---

<BaseLayout
  title={content.title}
  description={content.description}
  lang={lang}
  canonical={canonicalPath}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-stone-100 px-4 py-6 sm:py-10">
    <div class="mx-auto max-w-3xl">
      <!-- Top Navigation Bar -->
      <nav
        class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-3.5 shadow-2xs sm:p-4"
        aria-label="Breadcrumb navigation"
      >
        <div class="flex items-center gap-2">
          <a
            href={`/${lang}`}
            class="inline-flex min-h-[40px] items-center justify-center gap-1 rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95 sm:min-h-[36px]"
          >
            <span aria-hidden="true">←</span>
            {content.home}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Practice CTA -->
          <a
            href={`/${lang}/practice`}
            class:list={[
              'inline-flex min-h-[40px] items-center justify-center gap-1 rounded-full border-2 border-slate-900 bg-white px-4 py-2 leading-none font-bold whitespace-nowrap text-slate-800 shadow-2xs transition hover:bg-stone-100 active:scale-95 sm:min-h-[36px]',
              lang === 'fr'
                ? 'text-[11px] tracking-normal sm:text-xs'
                : 'text-[11px] tracking-wide sm:text-xs',
            ]}
          >
            <span aria-hidden="true">💡</span>
            <span>{practiceLabel[lang]}</span>
          </a>

          <!-- Install App Button -->
          <HeaderInstallButton lang={lang} />

          <!-- Language Selector -->
          <div
            class="inline-flex overflow-hidden rounded-full border-2 border-slate-900"
            role="group"
            aria-label="Language"
          >
            {
              locales.map(({ code, label }) => {
                const active = lang === code;
                return (
                  <a
                    href={`/${code}/terms`}
                    hreflang={code}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'border-r-2 border-slate-900 px-3 py-2 text-xs font-bold tracking-wide transition last:border-r-0',
                      active
                        ? 'bg-blue-700 text-white'
                        : 'bg-stone-50 text-slate-900 hover:bg-stone-200',
                    ]}
                  >
                    {label}
                  </a>
                );
              })
            }
          </div>
        </div>
      </nav>

      <!-- Main Terms Hero Card -->
      <header
        class="relative mb-6 overflow-hidden rounded-2xl border border-amber-300 bg-gradient-to-br from-amber-50/90 via-white to-orange-50/40 p-5 text-slate-900 shadow-2xs sm:p-8"
      >
        <div class="relative z-10">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-500 px-3 py-1 text-[11px] font-extrabold tracking-wide text-slate-950 uppercase shadow-2xs"
            >
              <span>⚖️</span>
              <span>{content.eyebrow}</span>
            </span>
            <span
              class="rounded-full bg-rose-600/10 px-2.5 py-1 text-[11px] font-extrabold text-rose-800"
            >
              {content.unofficialBadge}
            </span>
          </div>

          <h1
            class="text-2xl font-black tracking-tight text-slate-950 sm:text-3xl lg:text-4xl"
          >
            {content.title}
          </h1>

          <p
            class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base"
          >
            {content.intro}
          </p>

          <p class="mt-2 text-xs font-bold text-slate-500">
            {content.lastUpdatedLabel}: {content.lastUpdated}
          </p>

          <!-- Key Metrics / Highlights Grid -->
          <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            <div
              class="rounded-xl border border-stone-200/90 bg-white/95 p-3 shadow-2xs"
            >
              <span
                class="block text-[10px] font-bold tracking-wider text-slate-500 uppercase"
              >
                {statsLabels[lang].statusTitle}
              </span>
              <span
                class="mt-0.5 block text-xs font-black text-slate-900 sm:text-sm"
              >
                {statsLabels[lang].statusDesc}
              </span>
            </div>

            <div
              class="rounded-xl border border-stone-200/90 bg-white/95 p-3 shadow-2xs"
            >
              <span
                class="block text-[10px] font-bold tracking-wider text-slate-500 uppercase"
              >
                {statsLabels[lang].govTitle}
              </span>
              <span
                class="mt-0.5 block text-xs font-black text-slate-900 sm:text-sm"
              >
                {statsLabels[lang].govDesc}
              </span>
            </div>

            <div
              class="rounded-xl border border-stone-200/90 bg-white/95 p-3 shadow-2xs"
            >
              <span
                class="block text-[10px] font-bold tracking-wider text-slate-500 uppercase"
              >
                {statsLabels[lang].accessTitle}
              </span>
              <span
                class="mt-0.5 block text-xs font-black text-slate-900 sm:text-sm"
              >
                {statsLabels[lang].accessDesc}
              </span>
            </div>

            <div
              class="rounded-xl border border-stone-200/90 bg-white/95 p-3 shadow-2xs"
            >
              <span
                class="block text-[10px] font-bold tracking-wider text-slate-500 uppercase"
              >
                {statsLabels[lang].usageTitle}
              </span>
              <span
                class="mt-0.5 block text-xs font-black text-slate-900 sm:text-sm"
              >
                {statsLabels[lang].usageDesc}
              </span>
            </div>
          </div>
        </div>
      </header>

      <!-- Content Grid: Terms Sections + Sidebar -->
      <div class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
        <!-- Article Card with Numbered Sections -->
        <article
          class="rounded-2xl border border-stone-200 bg-white p-6 shadow-2xs sm:p-8"
        >
          <!-- Prominent Disclaimer Banner -->
          <div
            class="mb-8 rounded-xl border-2 border-amber-400 bg-amber-50/80 p-4.5 sm:p-5"
          >
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">⚠️</span>
              <div>
                <h2 class="text-sm font-black text-amber-950 sm:text-base">
                  {content.disclaimerTitle}
                </h2>
                <p
                  class="mt-1 text-xs leading-relaxed font-semibold text-amber-900"
                >
                  {content.disclaimerBody}
                </p>
              </div>
            </div>
          </div>

          <div class="space-y-8">
            {
              content.sections.map((section, index) => (
                <section class="border-t border-stone-100 pt-6 first:border-t-0 first:pt-0">
                  <div class="flex items-start gap-3.5">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-black text-amber-900 ring-1 ring-amber-500/30">
                      0{index + 1}
                    </span>
                    <div>
                      <h2 class="text-lg font-extrabold tracking-tight text-slate-950 sm:text-xl">
                        {section.title}
                      </h2>
                      <div class="mt-2.5 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
                        {section.paragraphs.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    </div>
                  </div>
                </section>
              ))
            }
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="space-y-6">
          <!-- Available Languages Card -->
          <section
            class="rounded-2xl border border-stone-200 bg-white p-5 shadow-2xs sm:p-6"
          >
            <h2 class="text-base font-extrabold text-slate-950">
              {content.languagesTitle}
            </h2>
            <ul class="mt-3.5 space-y-2" aria-label={content.languagesTitle}>
              {
                content.languages.map((language) => {
                  const item = languageMap[language];
                  const itemLang = item ? item.code : 'en';
                  const isCurrent = itemLang === lang;
                  return (
                    <li class="border-b border-stone-100 py-2 text-xs font-bold text-slate-700 last:border-b-0 sm:text-sm">
                      <a
                        href={`/${itemLang}/terms`}
                        class:list={[
                          'flex items-center justify-between rounded-lg px-2.5 py-1.5 transition',
                          isCurrent
                            ? 'bg-blue-50 font-extrabold text-blue-900'
                            : 'hover:bg-stone-50 hover:text-blue-700',
                        ]}
                      >
                        <span class="flex items-center gap-2">
                          <span>{item?.flag ?? '🌐'}</span>
                          <span>{language}</span>
                        </span>
                        {isCurrent && (
                          <span class="rounded-full bg-blue-700 px-2 py-0.5 text-[10px] font-bold text-white">
                            ✓
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </section>

          <!-- Report / Contact Card -->
          <section
            class="rounded-2xl border border-stone-200 bg-white p-5 shadow-2xs sm:p-6"
          >
            <h2 class="text-base font-extrabold text-slate-950">
              {content.reportTitle}
            </h2>
            <p class="mt-2 text-xs leading-relaxed text-slate-600 sm:text-sm">
              {content.reportText}
            </p>
            <a
              href={content.reportHref}
              rel="noopener noreferrer"
              target="_blank"
              class="mt-4 inline-flex min-h-[40px] items-center justify-center gap-2 rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
            >
              <svg
                class="h-4 w-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>{content.reportLink}</span>
            </a>
          </section>
        </aside>
      </div>

      <!-- Quick Navigation Footer Links -->
      <nav
        class="mt-6 grid gap-3 sm:grid-cols-3"
        aria-label={content.questions}
      >
        <a
          href={questionsListHref(lang, 1)}
          class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border-2 border-slate-900 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 hover:text-blue-700 active:scale-95"
        >
          <span>📝</span>
          <span>{content.questions}</span>
        </a>
        <a
          href={categoryHubHref(lang, 'traffic-rules')}
          class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border-2 border-slate-900 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 hover:text-blue-700 active:scale-95"
        >
          <span>⚖️</span>
          <span>{content.trafficRules}</span>
        </a>
        <a
          href={categoryHubHref(lang, 'road-signs')}
          class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border-2 border-slate-900 bg-white px-4 py-2.5 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 hover:text-blue-700 active:scale-95"
        >
          <span>🚦</span>
          <span>{content.roadSigns}</span>
        </a>
      </nav>
    </div>
  </main>
</BaseLayout>
