---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../lib/quiz';
import { categoryHubHref, questionsListHref } from '../lib/quiz';
import {
  absoluteUrl,
  breadcrumbJsonLd,
  hreflangAlternates,
  organizationJsonLd,
} from '../lib/seo';
import { getAboutContent } from '../lib/about-content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getAboutContent(lang);
const canonicalPath = `/${lang}/about`;
const alternates = hreflangAlternates(
  (locale) => `/${locale}/about`,
  Astro.site,
);
const jsonLd = [
  organizationJsonLd({ site: Astro.site, name: 'Provisoire' }),
  breadcrumbJsonLd(
    [
      { name: content.home, path: `/${lang}` },
      { name: content.about, path: canonicalPath },
    ],
    Astro.site,
  ),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: content.title,
    description: content.description,
    inLanguage: lang,
    url: absoluteUrl(canonicalPath, Astro.site),
    isPartOf: {
      '@type': 'WebSite',
      name: 'Provisoire',
      url: absoluteUrl('/', Astro.site),
    },
  },
];
---

<BaseLayout
  title={content.title}
  description={content.description}
  lang={lang}
  canonical={canonicalPath}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-stone-100 px-4 py-6 sm:py-10">
    <div class="mx-auto max-w-3xl">
      <div
        class="overflow-hidden rounded-3xl border border-emerald-700 bg-gradient-to-br from-emerald-600 via-emerald-500 to-emerald-700 shadow-sm"
      >
        <nav
          class="flex flex-wrap items-center justify-between gap-3 border-b border-emerald-800/80 px-6 py-4 sm:px-10"
          aria-label={content.about}
        >
          <a
            href={`/${lang}`}
            class="m-1 inline-flex min-h-[40px] items-center justify-center gap-1 rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95 sm:min-h-[36px]"
          >
            <span aria-hidden="true">←</span>
            {content.home}
          </a>
          <span
            class="m-1 inline-flex min-h-[40px] items-center justify-center rounded-full border-2 border-slate-900 bg-amber-300 px-4 py-2 text-xs font-extrabold text-slate-950 shadow-2xs sm:min-h-[36px]"
          >
            {content.about}
          </span>
        </nav>

        <header class="px-6 py-10 text-white sm:px-12 sm:py-14">
          <p
            class="mb-3 text-sm font-bold tracking-[0.12em] text-emerald-300 uppercase"
          >
            {content.eyebrow}
          </p>
          <h1
            class="max-w-2xl text-3xl leading-tight font-black tracking-tight sm:text-5xl"
          >
            {content.title}
          </h1>
          <p
            class="mt-5 max-w-2xl text-base leading-7 text-emerald-50/90 sm:text-lg"
          >
            {content.intro}
          </p>
        </header>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
        <article
          class="rounded-3xl border border-stone-200 bg-white px-6 py-8 shadow-sm sm:px-10 sm:py-10"
        >
          <div class="space-y-10">
            {
              content.sections.map((section, index) => (
                <section class="border-t border-stone-200 pt-6 first:border-t-0 first:pt-0">
                  <div class="flex gap-4">
                    <span class="pt-1 text-sm font-black text-blue-700">
                      0{index + 1}
                    </span>
                    <div>
                      <h2 class="text-xl font-extrabold text-slate-950 sm:text-2xl">
                        {section.title}
                      </h2>
                      <div class="mt-3 space-y-3 text-base leading-7 text-slate-700">
                        {section.paragraphs.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    </div>
                  </div>
                </section>
              ))
            }
          </div>
        </article>

        <aside class="space-y-6">
          <section
            class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8"
          >
            <h2 class="text-xl font-extrabold text-slate-950">
              {content.languagesTitle}
            </h2>
            <ul class="mt-4 space-y-2" aria-label={content.languagesTitle}>
              {
                content.languages.map((language) => (
                  <li class="border-b border-stone-200 py-2 text-sm font-bold text-slate-700 last:border-b-0">
                    {language}
                  </li>
                ))
              }
            </ul>
          </section>

          <section
            class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
          >
            <h2 class="text-xl font-extrabold text-slate-950">
              {content.reportTitle}
            </h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              {content.reportText}
            </p>
            <a
              href={content.reportHref}
              rel="noopener noreferrer"
              target="_blank"
              class="mt-5 inline-flex min-h-[40px] items-center justify-center rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
            >
              {content.reportLink}
            </a>
          </section>
        </aside>
      </div>

      <nav
        class="mt-6 grid gap-3 sm:grid-cols-3"
        aria-label={content.questions}
      >
        <a
          href={questionsListHref(lang, 1)}
          class="inline-flex min-h-[40px] items-center justify-center rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
        >
          {content.questions}
        </a>
        <a
          href={categoryHubHref(lang, 'traffic-rules')}
          class="inline-flex min-h-[40px] items-center justify-center rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
        >
          {content.trafficRules}
        </a>
        <a
          href={categoryHubHref(lang, 'road-signs')}
          class="inline-flex min-h-[40px] items-center justify-center rounded-full border-2 border-slate-900 bg-white px-4 py-2 text-xs font-extrabold text-slate-900 shadow-2xs transition hover:bg-stone-100 active:scale-95"
        >
          {content.roadSigns}
        </a>
      </nav>
    </div>
  </main>
</BaseLayout>
