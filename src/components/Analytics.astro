---
/**
 * Microsoft Clarity analytics, gated behind user cookie consent.
 *
 * Gating is dual-layer:
 * 1. Build-time: Injected only on production Cloudflare Pages builds (`CF_PAGES=1` & `CF_PAGES_BRANCH=main`).
 * 2. Client-time: Evaluates `localStorage.getItem('provisoire_cookie_consent') === 'granted'`.
 *    If consent is not granted, no script is injected and no cookies (_clck, _clsk) are set.
 *
 * `PUBLIC_CLARITY_PROJECT_ID` allows overriding the default project ID, or disabling it with an empty string.
 */
const DEFAULT_PROJECT_ID = 'yg4zez2uiv';

const configured = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const projectId = configured === undefined ? DEFAULT_PROJECT_ID : configured;

const isPagesProductionBuild =
  process.env.CF_PAGES === '1' && process.env.CF_PAGES_BRANCH === 'main';

const enabled =
  Boolean(projectId) && import.meta.env.PROD && isPagesProductionBuild;

const snippet = `(function initGatedClarity() {
  const STORAGE_KEY = 'provisoire_cookie_consent';
  let clarityInitialized = false;

  function loadClarity() {
    if (clarityInitialized) return;
    clarityInitialized = true;

    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", ${JSON.stringify(projectId)});
  }

  try {
    if (localStorage.getItem(STORAGE_KEY) === 'granted') {
      loadClarity();
    }
  } catch {
    // localStorage disabled
  }

  window.addEventListener('cookie-consent-updated', function(evt) {
    if (evt && evt.detail && evt.detail.consent === 'granted') {
      loadClarity();
    }
  });
})();`;
---

{enabled && <script is:inline set:html={snippet} />}
