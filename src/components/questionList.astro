---
import questionBank from '../../questions.json';
import type { Category, Lang, Question } from '../lib/quiz';
import { PAGE_SIZE, parsePageParam, totalQuestionPages } from '../lib/quiz';
import QuestionCard from './quiz/QuestionCard.astro';
import QuizHeader from './quiz/QuizHeader.astro';
import QuizPagination from './quiz/QuizPagination.astro';
import QuizToolbar from './quiz/QuizToolbar.astro';

interface Props {
  lang?: Lang;
  categoryId?: number;
  imageBase?: string;
  page?: number;
}

const {
  lang = 'en',
  categoryId,
  imageBase = '/',
  page: pageProp,
} = Astro.props;

const categories = questionBank.categories as Category[];
const allQuestions = (
  categoryId
    ? questionBank.questions.filter((q) => q.category_id === categoryId)
    : questionBank.questions
) as Question[];

const pageSize = PAGE_SIZE;
const totalPages = totalQuestionPages(allQuestions.length, pageSize);
const currentPage = parsePageParam(String(pageProp ?? 1), totalPages);
const start = (currentPage - 1) * pageSize;
const pageQuestions = allQuestions.slice(start, start + pageSize);
---

<section
  class="quiz mx-auto max-w-3xl rounded-2xl border border-stone-200 bg-stone-50 p-4 text-slate-900 sm:p-7"
  data-lang={lang}
  data-image-base={imageBase}
  data-page-size={pageSize}
  data-current-page={currentPage}
  data-total-pages={totalPages}
  data-site={Astro.site?.href ?? ''}
>
  <QuizHeader
    categories={categories}
    categoryId={categoryId}
    lang={lang}
    page={currentPage}
  />
  <QuizToolbar
    pageSize={pageSize}
    questionCount={allQuestions.length}
    currentPage={currentPage}
  />

  <ol class="m-0 flex list-none flex-col gap-5 p-0">
    {
      pageQuestions.map((q, i) => (
        <QuestionCard
          question={q}
          index={start + i}
          lang={lang}
          imageBase={imageBase}
          linked
        />
      ))
    }
  </ol>

  {
    pageQuestions.length === 0 && (
      <p class="py-8 text-center text-slate-500">
        No questions match this category yet.
      </p>
    )
  }

  <QuizPagination
    lang={lang}
    pageSize={pageSize}
    questionCount={allQuestions.length}
    currentPage={currentPage}
  />
</section>

<script>
  import { initAllQuizzes } from '../scripts/quiz-client';
  initAllQuizzes();
</script>
