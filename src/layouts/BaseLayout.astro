---
import '../styles/global.css';
import type { HreflangLink } from '../lib/seo';
import { absoluteUrl, ogLocale } from '../lib/seo';
import type { Lang } from '../lib/quiz';
import AppChrome from '../components/AppChrome.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** BCP 47 tag for <html lang>. Defaults to the current URL's locale. */
  lang?: string;
  /** Absolute or site-relative self-canonical URL. Defaults to the current pathname. */
  canonical?: string;
  /** Absolute or site-relative URL for <link rel="prev">. */
  prev?: string | null;
  /** Absolute or site-relative URL for <link rel="next">. */
  next?: string | null;
  /** hreflang alternate URLs for this page. */
  alternates?: HreflangLink[];
  /** Optional Open Graph image (absolute or site-relative). */
  image?: string | null;
  /** Accessible description for the Open Graph / Twitter image. */
  imageAlt?: string | null;
  /** Open Graph type. */
  type?: 'website' | 'article';
  /** JSON-LD objects to embed. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** robots directive, e.g. "index,follow" or "noindex,nofollow". */
  robots?: string;
}

const {
  title,
  description,
  lang = Astro.currentLocale ?? 'en',
  canonical: canonicalProp,
  prev,
  next,
  alternates = [],
  image,
  imageAlt = null,
  type = 'website',
  jsonLd,
  robots = 'index,follow',
} = Astro.props;

function toAbsolute(url: string): string {
  return absoluteUrl(url, Astro.site);
}

const canonical = toAbsolute(canonicalProp ?? Astro.url.pathname);
const prevHref = prev ? toAbsolute(prev) : null;
const nextHref = next ? toAbsolute(next) : null;
const imageHref = image
  ? toAbsolute(image)
  : toAbsolute('/icons/icon-512x512.png');
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const locale = (lang as Lang) || 'en';

// Ownership verification tokens for Google Search Console and Bing Webmaster
// Tools. Both are set as Cloudflare Pages environment variables; when unset the
// tags are omitted. (DNS TXT verification is preferred where available — these
// are the fallback for the HTML-tag method.)
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />
    {prevHref && <link rel="prev" href={prevHref} />}
    {nextHref && <link rel="next" href={nextHref} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={alt.href} />
      ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
    {
      bingSiteVerification && (
        <meta name="msvalidate.01" content={bingSiteVerification} />
      )
    }
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Provisoire" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/icons/icon-192x192.png"
    />

    <meta property="og:site_name" content="Provisoire" />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageHref} />
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {
      alternates
        .filter((alt) => alt.lang !== 'x-default' && alt.lang !== lang)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={ogLocale(alt.lang as Lang)}
          />
        ))
    }

    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageHref} />
    {image && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {
      jsonLdItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
    <script is:inline>
      // Early synchronous capture of beforeinstallprompt to ensure it's never missed
      window.__pwaInstallPrompt = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.__pwaInstallPrompt = e;
        window.dispatchEvent(new CustomEvent('pwa-installable'));
      });
      window.addEventListener('appinstalled', () => {
        window.__pwaInstallPrompt = null;
        window.__pwaIsInstalled = true;
        window.dispatchEvent(new CustomEvent('pwa-installed'));
      });
    </script>
  </head>
  <body class="bg-white text-slate-900">
    <slot />
    <AppChrome lang={locale} />
    <Analytics />
    <script>
      import { initPwaClient, registerServiceWorker } from '../lib/pwa';
      initPwaClient();
      registerServiceWorker();
    </script>
  </body>
</html>
