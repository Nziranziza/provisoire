---
import QuestionsPage from '../../../../components/QuestionsPage.astro';
import {
  CATEGORY_SLUGS,
  categoryIdFromSlug,
} from '../../../../lib/quiz';

export function getStaticPaths() {
  return Object.values(CATEGORY_SLUGS).map((category) => ({
    params: { category },
  }));
}

const categoryId = categoryIdFromSlug(Astro.params.category ?? '')!;
---

<QuestionsPage lang="en" page={1} categoryId={categoryId} />
