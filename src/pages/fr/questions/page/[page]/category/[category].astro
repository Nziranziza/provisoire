---
import { CATEGORY_SLUGS, categoryHubHref } from '../../../../../../lib/quiz';
import type { Lang } from '../../../../../../lib/quiz';

export function getStaticPaths() {
  return Object.values(CATEGORY_SLUGS).map((category) => ({
    params: { page: '1', category },
  }));
}

const lang = 'fr' as Lang;
return Astro.redirect(
  categoryHubHref(lang, Astro.params.category ?? 'traffic-rules'),
  301,
);
---
