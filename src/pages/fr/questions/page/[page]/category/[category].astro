---
import CategoryHubPage from '../../../../../../components/CategoryHubPage.astro';
import { CATEGORY_SLUGS } from '../../../../../../lib/quiz';

export function getStaticPaths() {
  return Object.values(CATEGORY_SLUGS).map((category) => ({
    params: { page: '1', category },
  }));
}

const { category } = Astro.params;
const categorySlug = category as 'traffic-rules' | 'road-signs';
---

<CategoryHubPage lang="fr" categorySlug={categorySlug} />
