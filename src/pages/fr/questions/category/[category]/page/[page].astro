---
import questionBank from '../../../../../../../questions.json';
import {
  CATEGORY_SLUGS,
  PAGE_SIZE,
  categoryHubHref,
  totalQuestionPages,
} from '../../../../../../lib/quiz';
import type { Lang } from '../../../../../../lib/quiz';

export function getStaticPaths() {
  return Object.entries(CATEGORY_SLUGS).flatMap(([id, category]) => {
    const count = questionBank.questions.filter(
      (q) => q.category_id === Number(id),
    ).length;
    const total = totalQuestionPages(count, PAGE_SIZE);
    return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
      params: { category, page: String(i + 2) },
    }));
  });
}

const lang = 'fr' as Lang;
const category = Astro.params.category ?? 'traffic-rules';
return Astro.redirect(categoryHubHref(lang, category), 301);
---
