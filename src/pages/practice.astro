---
import BaseLayout from '../layouts/BaseLayout.astro';
import IslandSmokeTest from '../components/IslandSmokeTest';

// The only route that ships a framework runtime. React loads here because of
// the `client:load` directive below, and nowhere else in the build.
---

<BaseLayout
  title="Practice — Provisoire"
  description="Practice the Rwanda provisional driving-test questions."
>
  <main class="mx-auto max-w-screen-sm px-4 py-10 sm:px-6 sm:py-16">
    <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">Practice</h1>
    <p class="mt-4 text-base text-slate-600">
      Placeholder for the practice engine island.
    </p>
    <div class="mt-6">
      <IslandSmokeTest client:load />
    </div>
  </main>
</BaseLayout>
