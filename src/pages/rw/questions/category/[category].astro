---
import { CATEGORY_SLUGS, categoryHubHref } from '../../../../lib/quiz';
import type { Lang } from '../../../../lib/quiz';

export function getStaticPaths() {
  return Object.values(CATEGORY_SLUGS).map((category) => ({
    params: { category },
  }));
}

const lang = 'rw' as Lang;
const category = Astro.params.category ?? 'traffic-rules';
return Astro.redirect(categoryHubHref(lang, category), 301);
---
